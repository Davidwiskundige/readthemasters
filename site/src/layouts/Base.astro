---
import "../styles/global.css";
const { title, description, ogType = "website", jsonLd } = Astro.props;
const siteTitle = "ReadTheMasters";
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
// Canonical URL from the configured `site` + this page's path. When `site` is unset (e.g. some
// dev contexts) `Astro.site` is undefined; fall back to the bare path so nothing renders "undefined".
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Toolbar tint = the header band's top colour, so the browser bar doesn't cut against it.
        Must equal every --band-top in global.css (a meta tag can't read a CSS variable). The
        first tag whose media matches wins, so the narrow-screen pair comes first. */}
    <meta name="theme-color" content="#1a1815" media="(max-width: 40rem) and (prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f5ef" media="(max-width: 40rem)" />
    <meta name="theme-color" content="#231e18" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f0e8" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    {/* Social preview (OpenGraph + Twitter). Values reuse the per-page title/description. */}
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? siteTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {/* Machine-readable structured data (schema.org), supplied per page type. */}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site">
      <nav>
        <a class="brand" href="/">
          <span class="wordmark">ReadTheMasters</span>
          <span class="rule"><span class="diamond">◆</span></span>
          <span class="tagline">Transcribe · Translate · Revive</span>
        </a>
        <div class="navlinks">
          <a href="/">Catalog</a>
          <a href="/timeline/">Timeline</a>
          <a href="/authors/">Authors</a>
          <a href="/journals/">Journals</a>
          <a href="/search/">Search</a>
          <a href="/about/">About</a>
          <a href="/copyright/">Copyright</a>
          <a href="/contribute/">Contribute</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script>
      import "../scripts/pop.js";
    </script>
    <footer class="site">
      <p>
        Transcriptions, translations and metadata are dedicated to the public domain (CC0).
        Original texts are public domain worldwide. This is a good-faith project and not legal
        advice — see <a href="/copyright/">Copyright &amp; takedown</a>.
      </p>
    </footer>
  </body>
</html>
