---
import Base from "../../layouts/Base.astro";
import data from "../../data/works.json";
import { texToHtml } from "../../lib/tex.js";
import { bibtexEntries } from "../../lib/bibtex.js";
import { workJsonLd } from "../../lib/jsonld.js";

export function getStaticPaths() {
  return (data.works ?? []).map((w) => ({ params: { id: w.id }, props: { work: w } }));
}

const { work } = Astro.props;
const authors = work.authors.map((a) => a.name).join(", ");
const tp = work.transcription_provenance ?? {};

function attribution(prov) {
  if (!prov) return "";
  const parts = [];
  if (prov.model) parts.push(prov.model);
  if (prov.effort) parts.push(`effort: ${prov.effort}`);
  const who = (prov.reviewers ?? []).map((r) => r.name).join(", ");
  let s = `Produced by ${parts.join(", ")}`;
  if (prov.produced) s += ` (${prov.produced})`;
  if (who) s += ` · reviewed by ${who}`;
  return s;
}

// Significance prose with inline [n] citation markers. Each renders as a small superscript
// marker whose full citation is hidden until you hover or click it (a popover).
function renderSignificance(text, sources) {
  const esc = (s) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  return esc(text).replace(/\[(\d+)\]/g, (m, n) => {
    const src = sources?.[Number(n) - 1];
    if (!src) return m;
    const cite = esc(src.citation);
    const inner = src.url ? `<a href="${esc(src.url)}" rel="noopener">${cite}</a>` : cite;
    return `<span class="pop cite" data-pagefind-ignore><button type="button" class="pop-marker" aria-label="Citation ${n}">${n}</button>` +
           `<span class="pop-content" role="note">${inner}</span></span>`;
  });
}

const figOpts = { figureBase: `/figures/${work.id}/` };
const originalHtml = texToHtml(work.original_tex, figOpts);
// Each translation prefixes its page anchors so `p-236` stays unique across the panels of one page.
const translations = Object.entries(work.translations ?? {}).map(([lang, t]) => ({
  lang, label: t.label, html: texToHtml(t.tex, { ...figOpts, idPrefix: `${lang}-` }),
  prov: t.provenance, pdf: t.pdf, tex_url: t.tex_url,
}));
const externalTranslations = work.external_translations ?? [];

// Ready-made BibTeX for the original, our edition, and translations, indexed by kind so each
// entry can sit next to its own source/download row rather than in a block at the bottom.
const citations = bibtexEntries(work, { base: Astro.site?.origin ?? "" });
const citeOriginal = citations.find((c) => c.kind === "original");
const citeTranscription = citations.find((c) => c.kind === "transcription");
const citeByLang = Object.fromEntries(
  citations.filter((c) => c.kind === "translation").map((c) => [c.lang, c]));
const citeExternal = citations.filter((c) => c.kind === "external");

// One consolidated download list, each row carrying its own citation.
const downloads = [
  { label: `Original (${work.language_label})`, tex: work.original_tex_url,
    pdf: work.original_pdf, cite: citeTranscription },
  ...translations.map((t) => ({ label: `${t.label} translation`, tex: t.tex_url,
    pdf: t.pdf, cite: citeByLang[t.lang] })),
];

// Prefilled "report an error" issue link (PLAN.md backlog #1).
const repo = "https://github.com/Davidwiskundige/readthemasters";
const reportUrl = `${repo}/issues/new?title=${encodeURIComponent(`Error in ${work.id}`)}&body=${encodeURIComponent(`Work: ${work.id}\nWhere (page/paragraph):\nProblem:\n`)}`;

// Revision history is the curated `changelog` block from provenance.yaml, newest first (PLAN.md §9 #4).
const changelog = work.changelog ?? [];

// Related reading (dependency graph, work-relations): a one-line spine — the recommended previous
// read on the left, the recommended next on the right (surname + first few words of the title).
// The fuller graph, with cites/built-on-by, lives on /timeline/.
const recPrev = work.recommended_prev ?? null;
const recNext = (work.recommended_next ?? [])[0] ?? null;
const firstWords = (t, n = 5) => {
  const words = String(t ?? "").trim().split(/\s+/);
  return words.length > n ? words.slice(0, n).join(" ") + "…" : words.join(" ");
};

// Renders the one-line "Related reading" nav from recPrev/recNext. Called once near the top
// (below Significance) and again after the text, so a reader who just finished sees it without
// scrolling back up — both instances share this one render path so they can't drift apart.
// The bottom instance omits "Read first:" — telling a reader what they should have read *before*
// the text they just finished isn't actionable, so only "Next:" carries over there.
function relatedNavHtml(bottom) {
  const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const side = (rec, dir) => rec
    ? `<span class="relnav-dir">${esc(dir)}</span> <a href="${esc(rec.url)}" title="${esc(rec.title)}">${esc(rec.by)}, ${esc(firstWords(rec.title))}</a>`
    : "";
  if (bottom) {
    if (!recNext) return "";
    return `<nav class="relnav relnav-bottom" aria-label="Related reading">` +
      `<span class="relnav-side"></span>` +
      `<span class="relnav-side relnav-right">${side(recNext, "Next:")}</span>` +
      `</nav>`;
  }
  if (!recPrev && !recNext) return "";
  return `<nav class="relnav" aria-label="Related reading">` +
    `<span class="relnav-side">${side(recPrev, "Read first:")}</span>` +
    `<span class="relnav-side relnav-right">${side(recNext, "Next:")}</span>` +
    `</nav>`;
}
---
<Base title={work.title} description={work.title_en ?? work.title}
      ogType="article" jsonLd={workJsonLd(work, Astro.site?.origin ?? "")}>
  {/* data-pagefind-body marks what the search index covers: the significance note and the text
      panels below. Everything else (this heading block, downloads, notices, BibTeX store, site
      chrome) sits outside every body region, so it is not indexed as text — the heading block
      only contributes the metadata the search-result cards are built from. */}
  <div class="workhead">
    {/* Display title may carry LaTeX ($…$) that KaTeX renders (see the auto-render script below);
        the plain `title` stays the machine-readable one for search, the tab, and JSON-LD. */}
    <h1>{work.title_tex ?? work.title}</h1>
    <span class="sr-only" data-pagefind-meta="title">{work.title}</span>
    {(work.title_en_tex ?? work.title_en) && (
      <p class="sub"><em>{work.title_en_tex ?? work.title_en}</em></p>
    )}
    <p class="sub">
      {work.authors.map((a, i) => (
        <>{i > 0 && ", "}{a.slug ? <a href={`/authors/${a.slug}/`}>{a.name}</a> : a.name}</>
      ))} · {work.year}
      {work.venue_full && <> · {work.venue
        ? <a href={`/journals/${work.venue}/`}>{work.venue_full}</a>
        : work.venue_full}</>}
      · <span class={`badge ${work.status}`}>{work.status}</span>
    </p>
    {/* Key-only form (value = element text), so an author list containing commas survives. */}
    <span class="sr-only" data-pagefind-meta="author">{authors}</span>
    <span class="sr-only" data-pagefind-meta="year">{String(work.year)}</span>
    <span class="sr-only" data-pagefind-meta="status">{work.status}</span>
    <span class="sr-only" data-pagefind-meta="language">{work.language_label}</span>
  </div>

  <p>
    <strong>Source:</strong>
    <a href={work.source.scan_url} rel="noopener">original scan</a>
    {work.source.scan_id && <> ({work.source.scan_id})</>}
    {citeOriginal && <> <button class="chip copy" type="button" data-target={`bib-${citeOriginal.key}`}><span class="g">⧉</span> BibTeX</button></>}
    {work.publication_full && <><br /><span class="attr">{work.publication_full}</span></>}
  </p>

  {work.significance && (
    <aside class="significance" data-pagefind-body>
      <h2 id="significance">Significance</h2>
      <p set:html={renderSignificance(work.significance, work.significance_sources)} />
    </aside>
  )}

  {/* Related reading — the recommended spine on one line: previous read left, next read right.
      The full dependency graph (cites, built-on-by, …) is on /timeline/. */}
  <Fragment set:html={relatedNavHtml(false)} />

  {/* Jump to this work's place in the whole dependency graph, pre-focused. */}
  <p class="attr worktl"><a href={`/timeline/?focus=${work.id}`}>See this work in the timeline →</a></p>

  <section class="downloads">
    <h2>Downloads</h2>
    <ul>
      {downloads.map((d) => (
        <li>
          <span>{d.label}:</span>
          {d.tex && <a class="chip" href={d.tex} download rel="noopener"><span class="g">↓</span> .tex</a>}
          {d.pdf
            ? <a class="chip" href={d.pdf} download rel="noopener"><span class="g">↓</span> PDF</a>
            : <span class="attr note">PDF on deploy</span>}
          {d.cite && <button class="chip copy" type="button" data-target={`bib-${d.cite.key}`}><span class="g">⧉</span> BibTeX</button>}
        </li>
      ))}
      <li>
        <span class="attr">Shared preamble:</span>
        <a class="chip" href="/tex/readmasters.sty" download rel="noopener"><span class="g">↓</span> readmasters.sty</a>
        <span class="attr">(needed to compile a <code>.tex</code>)</span>
      </li>
      <li>
        <span class="attr">All citations:</span>
        <button id="dl-bib" class="chip" type="button" data-file={`${work.id}.bib`}><span class="g">↓</span> .bib</button>
      </li>
    </ul>
  </section>

  {work.status === "ai-draft" && (
    <div class="notice">
      This text is an <strong>AI draft</strong> and has not yet been human-checked.
      Spotted a mistake? <a href={reportUrl} rel="noopener">Report an error</a>.
    </div>
  )}

  <div class="tabs" role="tablist">
    <button role="tab" aria-selected="true" data-tab="original">Original ({work.language_label})</button>
    {translations.map((t) => (
      <button role="tab" aria-selected="false" data-tab={t.lang}>Translation ({t.label})</button>
    ))}
  </div>

  {/* Each panel carries a heading with the id the tabs and search results link to: `#original`,
      `#en`. The heading is for screen readers and for Pagefind sub-results — the visible label is
      the tab itself. */}
  <section class="text" data-panel="original" data-pagefind-body>
    <h2 class="sr-only" id="original">Original ({work.language_label})</h2>
    <p class="attr">{attribution(tp)}</p>
    <div set:html={originalHtml} />
  </section>
  {translations.map((t) => (
    <section class="text" data-panel={t.lang} data-pagefind-body hidden>
      <h2 class="sr-only" id={t.lang}>{t.label} translation</h2>
      <p class="attr">{attribution(t.prov)}</p>
      <div set:html={t.html} />
    </section>
  ))}

  {/* Same "Related reading" nav as near the top, repeated here so a reader who just finished the
      text sees what to read next without scrolling back up. */}
  <Fragment set:html={relatedNavHtml(true)} />

  {externalTranslations.length > 0 && (
    <section style="margin-top:2rem">
      <h2 style="font-size:1.1rem">Existing translations elsewhere</h2>
      <p class="attr">These are hosted by others; we link rather than duplicate them.</p>
      <ul>
        {externalTranslations.map((x, i) => (
          <li>
            <a href={x.url} rel="noopener">{x.title ?? `${x.language?.toUpperCase()} translation`}</a>
            {x.translator && <> — trans. {x.translator}</>}
            {x.year && <> ({x.year})</>}
            {x.venue && <>, {x.venue}</>}
            {x.license && <> · <span class="pill">{x.license}</span></>}
            {citeExternal[i] && <> · <button class="chip copy" type="button" data-target={`bib-${citeExternal[i].key}`}><span class="g">⧉</span> BibTeX</button></>}
            {x.note && <><br /><span class="attr">{x.note}</span></>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <p style="margin-top:2rem"><a href={reportUrl} rel="noopener">Report an error in this text →</a></p>

  {/* Revision history (PLAN.md backlog #4): the curated changelog from provenance.yaml, newest
      first, collapsed so it never competes with the text. Omitted when a work has no changelog. */}
  {changelog.length > 0 && (
    <details class="revhistory">
      <summary>Revision history ({changelog.length})</summary>
      <ul>
        {changelog.map((c) => (
          <li>
            <span class="attr">{c.date}</span>{" — "}{c.summary}
          </li>
        ))}
      </ul>
    </details>
  )}

  {/* Hidden BibTeX source for the inline "copy BibTeX" buttons and the .bib download. */}
  <div id="bib-store" hidden>
    {citations.map((c) => <pre id={`bib-${c.key}`}>{c.text}</pre>)}
  </div>

  <!-- KaTeX renders any inline math ($…$, \[…\]) present in the text. -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  <script>
    document.querySelectorAll('.tabs button').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const tab = btn.dataset.tab;
        document.querySelectorAll('.tabs button').forEach((b) =>
          b.setAttribute('aria-selected', String(b === btn)));
        document.querySelectorAll('[data-panel]').forEach((p) =>
          (p.hidden = p.dataset.panel !== tab));
        // Only a real click rewrites the hash — a programmatic click from applyHash() below must
        // not overwrite a deeper anchor like #en-p-236 with plain #en.
        if (e.isTrusted) history.replaceState(null, '', '#' + tab);
      });
    });

    // Deep links into a panel: `#en` (the translation) or `#en-p-236` (a page marker inside it).
    // Search results and shared links land here, so open the owning panel before scrolling —
    // a hidden panel cannot be scrolled to, and its equations cannot be measured.
    function applyHash() {
      const id = decodeURIComponent((location.hash || '').slice(1));
      if (!id) return;
      const el = document.getElementById(id);
      const panel = el && el.closest('[data-panel]');
      if (!panel) return;
      const btn = document.querySelector(`.tabs button[data-tab="${panel.dataset.panel}"]`);
      if (btn && btn.getAttribute('aria-selected') !== 'true') btn.click();
      el.scrollIntoView({ block: 'start' });
    }
    applyHash();
    addEventListener('hashchange', applyHash);

    // Popover markers (.pop) — significance citations and editorial notes — are wired globally
    // by scripts/pop.js (loaded from Base.astro).

    // Copy text to clipboard, with a fallback for non-secure/no-gesture contexts.
    async function copyText(text) {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch (_) { /* fall through */ }
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch (_) { ok = false; }
      document.body.removeChild(ta);
      return ok;
    }

    // Copy a single BibTeX entry (buttons live inline next to source/download rows).
    document.querySelectorAll('button.copy[data-target]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const pre = document.getElementById(btn.dataset.target);
        if (!pre) return;
        const ok = await copyText(pre.textContent);
        const prev = btn.textContent;
        btn.textContent = ok ? 'copied ✓' : 'press Ctrl+C';
        setTimeout(() => (btn.textContent = prev), 1500);
      });
    });

    // Download all entries as one .bib file.
    const dl = document.getElementById('dl-bib');
    if (dl) dl.addEventListener('click', () => {
      const all = [...document.querySelectorAll('#bib-store pre')].map((p) => p.textContent).join('\n\n');
      const blob = new Blob([all], { type: 'application/x-bibtex' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = dl.dataset.file;
      a.click();
      URL.revokeObjectURL(a.href);
    });
  </script>
  {/* Bundled by Astro (no `type="module"`, which would leave it inline) so the fitmath import
      below resolves against this file rather than the page URL — same as search.astro. */}
  <script>
    import renderMathInElement from "https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.mjs";
    import { decideFit } from "../../lib/fitmath.js";
    const KATEX_OPTIONS = {
      delimiters: [
        { left: "$$", right: "$$", display: true },
        { left: "\\[", right: "\\]", display: true },
        { left: "$", right: "$", display: false },
      ],
      throwOnError: false,
    };
    // Typeset a region at most once. Tracked per element, so switching tabs back and forth after
    // the first reveal costs nothing. Returns whether this call did the work.
    const typeset = new WeakSet();
    function renderMath(el) {
      if (typeset.has(el)) return false;
      typeset.add(el);
      renderMathInElement(el, KATEX_OPTIONS);
      return true;
    }


    // Narrow screens: a formula wider than the column would run under the \tag{n} that KaTeX
    // pins at the right edge. Measure each display equation and let the CSS (global.css)
    // left-align the ones that overflow and drop the number below the ones that can't sit
    // beside it — a centred formula needs the number's width clear on *both* sides. The rule
    // itself lives in lib/fitmath.js, where it is unit-tested; this function only feeds it.
    //
    // The four loops are deliberate. Reading layout straight after writing to it forces the
    // browser to recompute the whole document synchronously, so measuring and classing each
    // equation in one pass cost two full reflows *per formula*: ~0.3 s on a long work at desktop
    // width and over two minutes at phone width, all of it blocking the main thread. Batching the
    // reads and writes into whole-collection phases costs two reflows for the entire pass.
    // Keep it that way — no layout read may follow a classList write within a phase.
    function fitDisplayMath(root) {
      // A: read the available width while the previous run's classes are still applied — the same
      // moment this was sampled before batching, so no decision can shift.
      const eqs = [];
      for (const eq of root.querySelectorAll('.katex-display')) {
        const room = eq.clientWidth;
        if (!room) continue; // hidden panel — measured again when its tab is shown
        const html = eq.querySelector('.katex-html');
        if (!html) continue;
        eqs.push({ eq, html, tag: html.querySelector(':scope > .tag'), room });
      }
      // B: clear the previous run's classes, so C measures the formulas unstyled.
      for (const e of eqs) e.eq.classList.remove('wide', 'tag-below');
      // C: measure every formula and its number.
      for (const e of eqs) {
        let math = 0;
        for (const child of e.html.children) {
          if (child !== e.tag) math += child.getBoundingClientRect().width;
        }
        e.math = math;
        e.tagWidth = e.tag ? e.tag.getBoundingClientRect().width : null;
      }
      // D: apply the verdicts.
      for (const e of eqs) {
        const { wide, tagBelow } = decideFit(e.room, e.math, e.tagWidth);
        if (wide) e.eq.classList.add('wide');
        if (tagBelow) e.eq.classList.add('tag-below');
      }
    }

    // Typesetting is by far the most expensive thing on a long work — ~3 s per panel on
    // abel-1841-fonctions-transcendantes — and a bilingual work carries the same formulas twice
    // while only ever showing one panel. So only what is on screen is typeset now; a hidden panel
    // keeps its raw LaTeX until it is revealed (see the observer at the end of this script).
    //
    // Read from the DOM rather than assumed, so it does not matter which panel the markup happens
    // to open with. Deliberately synchronous: deferring this to a microtask to catch the panel a
    // deep link is about to open sounds better but is not, because whether the microtask lands
    // before or after the other script's applyHash() depends on whether the two scripts share a
    // task — one bundled file in production, two module fetches in dev. That difference left the
    // deep-link anchor thousands of pixels off in dev. A deep link therefore still typesets the
    // panel it opens *and* the one it opened over; that is no worse than before this change, and
    // correctness beats reclaiming the second panel on that one path.
    document.querySelectorAll('.significance, .workhead').forEach(renderMath);
    document.querySelectorAll('.text').forEach((el) => {
      if (!el.hasAttribute('hidden')) renderMath(el);
    });
    fitDisplayMath(document);

    // KaTeX's fonts arrive from the CDN after that first pass, and the formulas grow when they
    // land — so measure again once they are in. A deep link (e.g. a search result pointing at
    // #p-295) is scrolled into place on load, but that same font reflow then pushes the target
    // down; re-scroll to it once, so a formula-search hit lands on the right line.
    // `deepOnly` skips the case where the hash is just a panel's own id: a tab click rewrites the
    // hash to `#en`, and that is a record of which tab is open, not a request to jump anywhere.
    function scrollToHash(deepOnly) {
      const id = decodeURIComponent((location.hash || '').slice(1));
      const el = id && document.getElementById(id);
      if (!el || el.closest('[data-panel][hidden]')) return;
      if (deepOnly) {
        const panel = el.closest('[data-panel]');
        if (panel && panel.dataset.panel === id) return;
      }
      el.scrollIntoView({ block: 'start' });
    }

    if (document.fonts) document.fonts.ready.then(() => {
      fitDisplayMath(document);
      scrollToHash(false);
    });
    let fitTimer;
    addEventListener('resize', () => {
      clearTimeout(fitTimer);
      fitTimer = setTimeout(() => fitDisplayMath(document), 150);
    });
    // A translation panel is display:none until its tab is picked, so it can only be typeset and
    // measured once it is showing. Watch the panels' `hidden` attribute rather than the tab click:
    // both scripts on this page are bundled into one file, and the bundler is free to order them
    // either way — with this one first, a click-time pass runs while the incoming panel is still
    // hidden, skips every one of its equations (clientWidth 0) and leaves the panel unfitted.
    // Reacting to the flip itself cannot race it, and covers the programmatic flip a deep link
    // performs too. Only the panels' own attributes are observed, so the classes the pass writes on
    // the equations inside them never retrigger this.
    const panelWatch = new MutationObserver((records) => {
      // Fires in both directions; a panel being hidden needs nothing done to it.
      let didTypeset = false;
      for (const r of records) {
        if (!r.target.hasAttribute('hidden') && renderMath(r.target)) didTypeset = true;
      }
      fitDisplayMath(document); // must follow typesetting — it measures rendered KaTeX
      // Typesetting changes the height of every line below each formula, so a deep link that was
      // scrolled into place against the untyped panel is now pointing somewhere else. `applyHash()`
      // scrolls synchronously as it reveals the panel, before this observer's microtask runs, so
      // that scroll always lands early on a lazily typeset panel — put the reader back on the
      // anchor. Only after real work: a reveal of an already-typeset panel moves nothing.
      if (didTypeset) scrollToHash(true);
    });
    document.querySelectorAll('[data-panel]').forEach((p) =>
      panelWatch.observe(p, { attributes: true, attributeFilter: ['hidden'] }));
  </script>
</Base>
