---
import Base from "../../layouts/Base.astro";
import data from "../../data/works.json";

const authors = data.authors ?? [];
const life = (a) => (a.birth_year || a.death_year)
  ? `${a.birth_year ?? "?"} – ${a.death_year ?? "?"}` : null;
const plural = authors.length === 1 ? "" : "s";

// Placeholder initial for an author with no portrait, so their card keeps the same left inset as
// every other one and the text column stays aligned down the list. Last name, since that is what
// the list is sorted and scanned by.
const initial = (name) => {
  const last = (name ?? "").trim().split(/\s+/).pop() ?? "";
  return [...last][0]?.toUpperCase() ?? "";   // spread, so a surrogate pair stays one character
};
---
<Base title="Authors" description="Authors of the public-domain works transcribed and translated on ReadTheMasters.">
  <h1>Authors</h1>
  <input id="aq" class="searchbox" type="search" placeholder="Search authors…" aria-label="Search authors" />
  <p class="attr count"><span id="acount">{authors.length}</span> of {authors.length} author{plural}.</p>
  <ul class="authorlist" id="authorlist">
    {authors.map((a) => (
      <li class="card" data-search={`${a.name} ${a.bio ?? ""}`.toLowerCase()}>
        {/* Decorative: the name is in the heading beside it, inside the same link, so a described
            image would make a screen reader announce every author twice. */}
        {a.portrait?.thumb_url
          ? <div class="pbox"><img src={a.portrait.thumb_url} alt="" width="69" height="86" loading="lazy" /></div>
          : <div class="pbox mono" aria-hidden="true">{initial(a.name)}</div>}
        <div class="body">
          <h3><a href={a.url}>{a.name}</a></h3>
          <div class="meta">
            {life(a) && <span>{life(a)}</span>}
            {a.bio && <span>· {a.bio}</span>}
            <span class="pill">{a.work_count} work{a.work_count === 1 ? "" : "s"}</span>
          </div>
        </div>
      </li>
    ))}
  </ul>
  <p id="aempty" class="attr" hidden>No authors match your search.</p>

  <script>
    const q = document.getElementById("aq");
    const cards = [...document.querySelectorAll("#authorlist .card")];
    const countEl = document.getElementById("acount");
    const emptyEl = document.getElementById("aempty");
    function apply() {
      const term = (q.value || "").trim().toLowerCase();
      let shown = 0;
      for (const c of cards) {
        const ok = !term || c.dataset.search.includes(term);
        c.hidden = !ok;
        if (ok) shown++;
      }
      countEl.textContent = String(shown);
      emptyEl.hidden = shown > 0;
    }
    q.addEventListener("input", apply);
  </script>
</Base>
