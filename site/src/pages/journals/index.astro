---
import Base from "../../layouts/Base.astro";
import data from "../../data/works.json";

const journals = data.journals ?? [];
const plural = journals.length === 1 ? "" : "s";
---
<Base title="Journals" description="The journals and academy proceedings the works on ReadTheMasters were first published in — with where to find the originals.">
  <h1>Journals</h1>
  <p class="attr">The periodicals and academy proceedings our works first appeared in. Each links to
    where you can read the original run yourself. We've also included some journals in which great
    works appeared even though none of them are on the site yet.</p>
  <input id="jq" class="searchbox" type="search" placeholder="Search journals…" aria-label="Search journals" />
  <p class="attr count"><span id="jcount">{journals.length}</span> of {journals.length} journal{plural}.</p>
  <ul class="journallist" id="journallist">
    {journals.map((j) => (
      <li class="jrow" data-search={`${j.name} ${j.aka ?? ""} ${j.note ?? ""}`.toLowerCase()}>
        <a href={j.url}>{j.name}</a>
        {j.work_count > 0 && <span class="pill">{j.work_count} work{j.work_count === 1 ? "" : "s"}</span>}
      </li>
    ))}
  </ul>
  <p id="jempty" class="attr" hidden>No journals match your search.</p>

  <script>
    const q = document.getElementById("jq");
    const cards = [...document.querySelectorAll("#journallist .jrow")];
    const countEl = document.getElementById("jcount");
    const emptyEl = document.getElementById("jempty");
    function apply() {
      const term = (q.value || "").trim().toLowerCase();
      let shown = 0;
      for (const c of cards) {
        const ok = !term || c.dataset.search.includes(term);
        c.hidden = !ok;
        if (ok) shown++;
      }
      countEl.textContent = String(shown);
      emptyEl.hidden = shown > 0;
    }
    q.addEventListener("input", apply);
  </script>
</Base>
